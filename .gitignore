# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local browser-profile and server-log byproducts from visual QA. Screenshot evidence stays tracked.
/artifacts/qa/*-profile/
/artifacts/qa/*.log

# One-off, machine-specific browser tooling used to capture external design references.
# The resulting reports and screenshot evidence remain tracked.
/artifacts/research/**/browser-tools/
/artifacts/research/**/capture-*.cjs
/artifacts/research/**/inspect-*.cjs

# Kepler Fold regeneration: keep the final 10 assets tracked, hide the
# alternate candidates and intermediate 4K source renders. To swap a
# different candidate, move it up to the folder root and re-commit.
public/media/kepler-fold/_candidates/
public/media/kepler-fold/_build/

# One-off audit dumps; visual evidence already lives in tracked subfolders.
/artifacts/audit-*/
/artifacts/research/current-implementation-audit/
/artifacts/contact-after-*.html
