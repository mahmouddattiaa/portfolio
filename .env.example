# Contact form provider — Formspree is the configured path.
# When CONTACT_PROVIDER="formspree" and FORMSPREE_FORM_ID is set, the
# /contact form is enabled. Otherwise the route renders the verified
# mailto fallback below as a permanent secondary action.
CONTACT_PROVIDER=
FORMSPREE_FORM_ID=

# Server-side fallback (used by the API route handler if the provider fails).
CONTACT_FALLBACK_EMAIL=

# Public fallback email surfaced on the /contact route hero and unavailable
# state. Replace with a real verified address before going live. The value is
# a placeholder for development — no real personal address lives here.
NEXT_PUBLIC_CONTACT_FALLBACK_EMAIL=project-review@keplerdev.example
